FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      filterProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

filter          off;

filterNormal    ( 0 0 1 );

filterPosition  filterPosition [ 0 1 0 0 0 ] ( 0 0 0.02 );

filterThickness filterThickness [ 0 1 0 0 0 ] 1e-06;


