FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      createBafflesDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

internalFacesOnly true;

baffles
{
    bridgeDeckBaffle
    {
        type        faceZone;
        zoneName    bridgeDeckFaceSet;

        patches
        {
            master
            {
                name        bridgeDeck;
                type        wall;
            }
            slave
            {
                name        bridgeDeck;
                type        wall;
            }
        }
    }
}

