FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      p_rgh;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [1 -1 -2 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    inlet
    {
        type            zeroGradient;
    }

    outlet
    {
        type            zeroGradient;  // Prevents artificial suction draining of water column
    }

    bottom
    {
        type            fixedFluxPressure;
        value           uniform 0;
    }

    bridgeDeck
    {
        type            fixedFluxPressure;
        value           uniform 0;
    }

    frontAndBack
    {
        type            empty;
    }
    
    atmosphere
    {
        type            fixedValue;
        value           uniform 0;    // Hydrostatic pressure reference datum at domain top
    }
}

